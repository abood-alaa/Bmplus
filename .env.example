# Copy to .env for local dev, or set these as Environment Variables on the
# cPanel "Setup Node.js App" page for production. Never commit the real .env file
# (it's gitignored) or paste real secret values into this example file.
#
# ADMIN_PASSWORD, DB_USER, DB_PASS and DB_NAME have NO built-in
# fallback — server.js logs a critical error and disables the affected feature
# (admin panel / DB connection) until each is set. SMTP_PASS also has no
# fallback, but is intentionally non-fatal: order notification emails are
# skipped (with a warning logged) until it's configured, while order
# submission itself keeps working.

# ── Admin panel ──────────────────────────────────────────────────────────────
# Admin panel login password. Sessions are random tokens stored (hashed) in the
# admin_sessions DB table, so no separate signing secret is needed anymore.
ADMIN_PASSWORD=change-me
# Recipient(s) for new-order notification emails. Comma-separated for multiple.
ADMIN_EMAIL=admin@example.com

# ── Public URL / CORS ────────────────────────────────────────────────────────
# Canonical base URL of the site. Used to build the file links in notification
# emails, to generate sitemap.xml, and as the default CORS origin. Must be the
# non-www form, matching the <link rel="canonical"> in index.html.
BASE_URL=https://gs.bmexpress.co

# Comma-separated CORS allowlist. Required here because BOTH the apex and the www
# hostname serve the site — browsers treat them as different origins, and CORS
# matching is an exact string compare, so listing only one returns 403 on every
# form submission made from the other.
#
# Exact-match rules (each of these fails with 403 if you get it wrong):
#   • scheme must match       https://  not  http://
#   • no trailing slash       https://gs.bmexpress.co   not  .../
#   • www is a separate origin, never implied by the apex
ALLOWED_ORIGINS=https://gs.bmexpress.co,https://www.gs.bmexpress.co

# ── SMTP (noreply@bmexpress.co mailbox) ─────────────────────────────────────
# Leave SMTP_PASS unset until the mailbox is actually provisioned on cPanel —
# the app degrades gracefully (skips sending, order intake keeps working).
SMTP_HOST=mail.bmexpress.co
SMTP_PORT=465
SMTP_USER=noreply@bmexpress.co
SMTP_PASS=change-me
# Optional: only set to false if the mailbox's TLS certificate genuinely fails
# validation (test with test-smtp.mjs first) — leave unset/true otherwise.
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=change-me
DB_PASS=change-me
DB_NAME=change-me

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Passenger overrides this with its own socket in production — safe to leave
# unset on cPanel.
PORT=3000
